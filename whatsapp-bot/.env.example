# মেইন ওয়েব অ্যাপ (Vercel)-এর WHATSAPP_BOT_SECRET এর সাথে হুবহু মিলতে হবে
BOT_SECRET=change-this-to-a-long-random-string

# MongoDB Atlas free (M0) cluster থেকে পাওয়া connection string
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Render নিজে থেকেই PORT সেট করে দেয়; লোকাল টেস্টের সময় 4000 রাখুন যাতে
# 'vercel dev'-এর ডিফল্ট 3000-এর সাথে সংঘর্ষ না হয় (দুটো একসাথে চালানো হলে)
PORT=4000
