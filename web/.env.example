# === Google Sheets (Database) ===
# Google Cloud Service Account থেকে পাওয়া তথ্য (SETUP_GUIDE.md-এর Step 2 দেখুন)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Private key-টা .json ফাইল থেকে হুবহু কপি করুন, \n গুলো এভাবেই থাকবে (quotes সহ)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXXXXXXXXXXXXXXXXXX\n-----END PRIVATE KEY-----\n"
# Sheet-এর URL-এর মাঝখানের লম্বা ID টুকু, যেমন: docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEET_ID=your-google-sheet-id
# Drive-এ যে ফোল্ডার service account-এর সাথে শেয়ার করেছেন, তার ফোল্ডার ID
# (ছাত্র-ছাত্রী/গার্ডিয়ান/শিক্ষকের ছবি এখানে জমা হবে — Sheet-এর ঘরে ছবি রাখা যায় না)
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id

# === Admin Login ===
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
# যেকোনো লম্বা এলোমেলো string — লগইন সেশন সাইন করতে ব্যবহার হয়
JWT_SECRET=change-this-to-a-long-random-string

# === WhatsApp Bot (Render-এ ডিপ্লয় করা /whatsapp-bot সার্ভিসের ঠিকানা) ===
WHATSAPP_BOT_URL=https://your-whatsapp-bot.onrender.com
WHATSAPP_BOT_SECRET=change-this-to-a-long-random-string
